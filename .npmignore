# Comprehensive exclusions to minimize package size
# Only include what's strictly necessary for headless testing

# Build artifacts and development files
*.log
*.tgz
.DS_Store
.env
.env.*
*.map

# Electron app files
.app/
electron-main.js
index.html

# Large UI assets and docs
doc/
lore/
markdown/
assets/
dist/
bundle/

# Development tools and configs
tools/
.github/
.vscode/
.idea/
webpack.config.js
.eslintrc.js
.eslintignore
.prettierrc
.prettierignore
Dockerfile
docker-compose.yml
.dockerignore
.gitattributes
.git_blame_ignore_revs
.readthedocs.yaml
favicon.ico
.browserslistrc
.editorconfig
.nojekyll
CODE_OF_CONDUCT.md
CONTRIBUTING.md

# Test files not needed for CLI
test/netscript/
test/__mocks__/
test/examples/

# Source files not needed (keep only compiled/necessary ones)
src/ui/
src/Casino/
src/Literature/
src/Lore/
src/Message/
src/Themes/
src/Achievements/
src/Company/
src/Corporation/
src/DevMenu/
src/Faction/
src/Gang/
src/Infiltration/
src/Milestones/
src/MissionBoard/
src/SaveObject/
src/Settings/
src/SourceFile/
src/TravelAgency/
src/StockMarket/
src/Sleeve/
src/Bladeburner/
src/CodingContract/
src/Go/

# Keep minimal test infrastructure
!test/jest/Utilities.ts
!test/jest/Utilities.js

# Keep only headless essentials
!headless/**
